@model adonetdatabase.Models.User
@{
    ViewData["Title"] = "Create";
}


<div class="min-h-100 p-4  d-flex align-items-center justify-content-center bg-light">

 <div class="bg-white p-4 rounded shadow-sm" style="width: 400px;">

    <h4 class="text-center mb-4">USER FORM</h4>
<form asp-action="Create" method = "post">
    @Html.AntiForgeryToken()

<div >
<label asp-for="Name"></label>
<input asp-for="Name" class="form-control"/>
<span asp-validation-for="Name" class="text-danger p-2" ></span>

</div>

<div class="mb-3"> 
<label asp-for="Gender"></label>
<input asp-for="Gender"  class="form-control"/>

</div>


<div class="mb-3">
<label asp-for="Age"></label>
<input asp-for="Age" type="number" class="form-control" />
<span asp-validation-for="Age" class="text-danger p-2" ></span>

</div>


<div class="mb-3">
<label  asp-for="Email"></label>
<input asp-for="Email" type="email"  class="form-control"/>
<span asp-validation-for="Email" class="text-danger p-2" ></span>


</div>

<button class="btn btn-pink form-control mb-3">Add User </button>



</form>
</div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


