@model List<adonetdatabase.Models.User>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}


<h2>ALL USERS</h2>
<table>
    <thead>
    <tr>Name</tr>
    <tr>Gender</tr>
    <tr>Age</tr>
    <tr>>Email</tr>
    </thead>


    <tbody >
        @foreach (var user in Model)
        {
            <tr>
          <td>@user.Name</td>
        <td>@user.Gender</td>
        <td>@user.Age</td>
        <td>@user.Email</td>
        </tr>
        }
        
    </tbody>
    
</table>